APP_NAME=Fashionku
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fashionku
DB_USERNAME=root
DB_PASSWORD=

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=127.0.0.1

# ─── Sanctum (Cookie-based Auth untuk SPA) ───────────────────────────────────
# Karena sekarang frontend & backend berjalan di port yang sama (via Vite proxy),
# cukup daftarkan host:port dev server Vite di sini.
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173

# ─── Broadcasting / Queue / Cache ────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="halo@fashionku.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS (optional) ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Vite (vars yang diekspos ke frontend) ───────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=

# Konfigurasi dev server Vite (opsional — override di kebutuhan CI/staging)
VITE_DEV_BROWSER_HOST=127.0.0.1
VITE_DEV_BROWSER_PORT=5173
# HMR manual (dua terminal terpisah): set true + jalankan `npm run dev`, akses app via Laravel (8000).
# Default false = pakai public/build, cukup `php artisan serve`.
VITE_USE_DEV_SERVER=false
# VITE_DEV_BACKEND_TARGET=http://127.0.0.1:8000   # Default: http://127.0.0.1:8000
# VITE_DEV_REVERB_TARGET=http://127.0.0.1:8080    # Default: http://127.0.0.1:8080

# ─── Firebase (client/web — login Google di React) ───────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin (server — verifikasi ID token) ──────────────────────────
# Wajib service account JSON untuk login Google via backend.
FIREBASE_CREDENTIALS=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_AUTH_ENABLED=false

# ─── Midtrans (diperlukan untuk pembayaran online) ───────────────────────────
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ENABLED_PAYMENTS=gopay,shopeepay,qris,echannel,akulaku

# Ekspos client key ke frontend React (dibutuhkan Snap.js)
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=false

# ─── Reverb / WebSocket (opsional — diperlukan untuk realtime chat) ──────────
REVERB_APP_ID=fashionku
REVERB_APP_KEY=fashionku-app-key
REVERB_APP_SECRET=fashionku-app-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Shipping / Kurir (opsional — RajaOngkir/Komerce) ────────────────────────
SHIPPING_API_KEY=
SHIPPING_BASE_URL=
